{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "UserManager",
    "Audience": "UserManager.Client",
    "SecretKey": "CHANGE_THIS_IN_USER_SECRETS_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARACTERS",
    "ExpireMinutes": 60
  }
}
